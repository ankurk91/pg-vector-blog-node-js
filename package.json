{
  "name": "pgvector-blog-similarity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js | pino-pretty",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/cli/migrate.js",
    "seed": "node --env-file-if-exists=.env src/cli/seed.js",
    "embed": "node --env-file-if-exists=.env src/cli/embed.js",
    "lint": "oxlint --deny-warnings",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.86.0",
    "pino-pretty": "^13.1.3"
  }
}
